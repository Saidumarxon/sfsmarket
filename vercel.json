{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"console.log('static deploy')\"",
  "installCommand": "echo skip",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "emirateco.uz" }],
      "destination": "https://www.emirateco.uz/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/catalog.html",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/product.html",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/delivery.html",
      "destination": "/delivery",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/auth-send-otp",
      "destination": "/api/auth-sms"
    },
    {
      "source": "/api/auth-verify-otp",
      "destination": "/api/auth-sms"
    },
    {
      "source": "/api/telegram-set-webhook",
      "destination": "/api/telegram-webhook?setup=1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/catalog",
      "destination": "/catalog.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/auth-callback",
      "destination": "/auth-callback.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/delivery",
      "destination": "/delivery.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    }
  ]
}
